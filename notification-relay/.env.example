LPM_RELAY_DATABASE_URL=sqlite:////data/relay.db
LPM_RELAY_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
LPM_RELAY_SECRET_HASH_KEY=replace-with-a-long-random-secret
