<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- LAN PC Monitor navy/cyan palette. Semantic names are preferred by new UI. -->
    <Color x:Key="Primary">#00D8F0</Color>
    <Color x:Key="PrimaryDark">#00D8F0</Color>
    <Color x:Key="PrimaryDarkText">#071426</Color>
    <Color x:Key="Secondary">#00B8D4</Color>
    <Color x:Key="SecondaryDarkText">#00B8D4</Color>
    <Color x:Key="Tertiary">#10243A</Color>

    <Color x:Key="White">#F5F8FC</Color>
    <Color x:Key="Black">#F5F8FC</Color>
    <Color x:Key="Magenta">#00D8F0</Color>
    <Color x:Key="MidnightBlue">#F5F8FC</Color>
    <Color x:Key="OffBlack">#071426</Color>

    <Color x:Key="Gray100">#F5F8FC</Color>
    <Color x:Key="Gray200">#AAB7C8</Color>
    <Color x:Key="Gray300">#66768A</Color>
    <Color x:Key="Gray400">#66768A</Color>
    <Color x:Key="Gray500">#1D3248</Color>
    <Color x:Key="Gray600">#66768A</Color>
    <Color x:Key="Gray900">#0B1A2C</Color>
    <Color x:Key="Gray950">#071426</Color>
    <Color x:Key="PageBackground">#071426</Color>
    <Color x:Key="CardBackground">#0B1A2C</Color>
    <Color x:Key="ElevatedSurface">#10243A</Color>
    <Color x:Key="ActionSurface">#10243A</Color>
    <Color x:Key="ActionPressed">#16344F</Color>
    <Color x:Key="PrimaryText">#F5F8FC</Color>
    <Color x:Key="SecondaryText">#AAB7C8</Color>
    <Color x:Key="BorderColor">#1D3248</Color>
    <Color x:Key="DisabledColor">#66768A</Color>
    <Color x:Key="LightPageBackground">#F5F8FC</Color>
    <Color x:Key="LightCardBackground">#EAF1F7</Color>
    <Color x:Key="LightElevatedSurface">#DCE8F2</Color>
    <Color x:Key="LightActionSurface">#DCE8F2</Color>
    <Color x:Key="LightActionPressed">#C9DCE9</Color>
    <Color x:Key="LightPrimaryText">#071426</Color>
    <Color x:Key="LightSecondaryText">#52657A</Color>
    <Color x:Key="LightBorderColor">#C4D2DF</Color>
    <Color x:Key="LightDisabledColor">#91A0B2</Color>
    <Color x:Key="LightAccent">#007F94</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Critical">#DC2626</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
